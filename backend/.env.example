# Copie este archivo como backend/.env y llene los valores.
# backend/.env NO se sube al repositorio: guarda claves y datos de contacto.

# ── Base de datos (se crea sola la primera vez) ─────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dromatic_dis
DB_USERNAME=root
DB_PASSWORD=

# ── Sesión ──────────────────────────────────────────────────────────
# Clave de al menos 32 caracteres. Genere una propia y no la suba al repositorio.
JWT_SECRET=
JWT_EXPIRATION_MS=28800000
# Minutos de bloqueo después de 5 intentos fallidos
LOCK_MINUTES=15

# ── Alertas de stock bajo ───────────────────────────────────────────
# Correo y WhatsApp de quien recibe las alertas la primera vez que arranca
# el sistema (después se cambian en Usuarios). WhatsApp con indicativo y sin +.
ALERT_EMAIL=
ALERT_WHATSAPP_PHONE=

# Servidor de correo para enviar las alertas (opcional).
#   Gmail:   MAIL_HOST=smtp.gmail.com      MAIL_PORT=587  (usar una "contraseña de aplicación")
#   Outlook: MAIL_HOST=smtp.office365.com  MAIL_PORT=587
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Remitente; si se deja vacío se usa MAIL_USERNAME
MAIL_FROM=

# ── Servidor ────────────────────────────────────────────────────────
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Dirección con la que se abre el sistema (para los enlaces de los correos)
APP_PUBLIC_URL=http://localhost:5173
